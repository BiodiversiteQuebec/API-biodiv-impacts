# GitHub Credentials (needed during docker build for private bq_impact_indicators repository)
MY_GITHUB_USERNAME=your_github_username
BQ_IMPACTS_GITHUB_TOKEN=your_personal_access_token

# STAC Catalog & Data Services
IO_STAC_CATALOG_URL=https://io.biodiversite-quebec.ca/stac/
ACER_STAC_CATALOG_URL=https://acer.biodiversite-quebec.ca/stac
GEOIO_API_SERVER=https://geoio.biodiversite-quebec.ca/
TITILER_STATS_URL=https://tiler2.biodiversite-quebec.ca

# Atlas API
ATLAS_API_SERVER=https://atlas.biodiversite-quebec.ca/
ATLAS_API_PATH=api/v4/
ATLAS_API_TOKEN=your_atlas_api_token

# Server Port (optional, default: 8042)
PORT=8042

